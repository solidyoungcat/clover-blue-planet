{
  "name": "desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"pnpm --filter web dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:ts": "tsc",
    "build": "pnpm build:ts && pnpm --filter web build && electron-builder --win --mac"
  },
  "build": {
    "appId": "com.clover.blueplanet",
    "productName": "四叶草蓝星球",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../web/dist/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": null
    },
    "mac": {
      "target": ["dmg"],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@clover/shared": "workspace:*"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0",
    "wait-on": "^7.2.0"
  }
}
